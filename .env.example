# Copy to .env (gitignored) and fill in real values -- never commit a real key.
# Shared API-key auth for all 5 scoring services (src/aml_riskiq/serving/_security.py).
# Direct source execution may use open mode when unset. Docker images fail closed by default
# (AML_RISKIQ_REQUIRE_AUTH=true) and will refuse startup without a non-empty key list -- see SECURITY.md.
# AML_RISKIQ_API_KEYS=replace-with-a-real-secret-before-running-a-scoring-container

# Optional override of the default 60/minute rate limit on /score (see SECURITY.md).
# AML_RISKIQ_SCORE_RATE_LIMIT=60/minute

# Fail-closed gate (see SECURITY.md). Docker images enable this by default. For direct source
# execution, enable it in every non-local deployment; leave unset only for local development.
# AML_RISKIQ_REQUIRE_AUTH=true

# Per-service dataset variant selector (HI-Small or LI-Medium) -- set per container, see each
# src/docker/*/docker-compose.yml for the real default.
# BP1_DATASET_VARIANT=LI-Medium

# --- Case Management Service (src/aml_riskiq/serving/case_management_service.py) ---

# Optional override of the default 60/minute rate limit on Case Management Service routes
# (see docs/security/RBAC.md). Falls back to AML_RISKIQ_SCORE_RATE_LIMIT's own default if unset.
# AML_RISKIQ_CASE_RATE_LIMIT=60/minute

# Optional override of the SQLite database file path for the AlertStore. Defaults to
# <project root>/data/case_management/casework.db. Set this explicitly in any deployment
# where automatic project-root resolution is not reliable (see project_root.py).
# AML_RISKIQ_CASE_DB_PATH=/absolute/path/to/casework.db

# --- Scoring-to-alert dispatch (src/aml_riskiq/serving/_alert_dispatch.py) ---
# Lets each BP1/BP2/BP4/BP5 scoring service call the Case Management Service's
# POST /alerts/ingest when a score crosses its alert-worthiness line. See
# docs/architecture/SCORING_ALERT_INTEGRATION.md.

# Base URL of the running Case Management Service. No default -- if unset, alert dispatch
# is skipped entirely (scoring still succeeds; see that module's own docstring).
# AML_RISKIQ_CASE_SERVICE_URL=http://localhost:8005

# API key this scoring service presents to the Case Management Service's RBAC-protected
# /alerts/ingest route (must carry a role /alerts/ingest accepts -- see docs/security/RBAC.md).
# Never reuse a human analyst's own key here; issue a dedicated service-to-service key.
# AML_RISKIQ_CASE_SERVICE_API_KEY=replace-with-a-real-service-key

# Per-attempt HTTP timeout (seconds) for an alert-dispatch call. Default: 2.0.
# AML_RISKIQ_CASE_DISPATCH_TIMEOUT_SECONDS=2.0

# Max attempts (including the first) before an alert is written to the local outbox
# instead of being delivered inline. Default: 2.
# AML_RISKIQ_CASE_DISPATCH_MAX_ATTEMPTS=2

# Base seconds for exponential backoff between retry attempts. Default: 0.1.
# AML_RISKIQ_CASE_DISPATCH_BACKOFF_BASE_SECONDS=0.1

# Directory for the durable local outbox file used when inline delivery is exhausted
# (replayed later via scripts/replay_alert_outbox.py). Defaults to a path under the
# resolved project root; set explicitly in any deployment where that resolution is not
# reliable.
# AML_RISKIQ_ALERT_OUTBOX_DIR=/absolute/path/to/outbox

# --- Project-root resolution (src/aml_riskiq/utils/project_root.py) ---
# Used by every service/script that needs to locate the real project tree (e.g. to find
# PROJECT_STRUCTURE_LOCKED.md, data/, models/). Only needed when the automatic upward-walk
# from the current working directory (or the Docker /app fallback) cannot find it --
# e.g. a service run from an unusual working directory, or a non-standard deployment layout.
# AML_RISKIQ_SUITE_ROOT=/absolute/path/to/IBM_AML_RiskIQ_Enterprise_Suite
