# Raw / processed data - never committed (Quality Gates, zero-fabrication + compliance)
data/raw/**
data/processed/**
data/external/**
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Models / large artifacts
models/**/*.joblib
models/**/*.pkl
models/**/*.onnx
*.parquet
# Exceptions (2026-10-03): the 6 real, small champion artifacts MODEL_REGISTRY.md documents by
# SHA-256 -- each under 25MB, needed for the Dockerfiles to actually build and for
# docker-verify.yml's CI job to run a real container, not a staging-area copy.
!models/bp1_transaction_monitoring_detection/bp1_notebook3_champion_li_medium.pkl
!models/bp2_typology_redflag_detection/bp2_notebook3_champion_li_medium.pkl
!models/bp2_typology_redflag_detection/bp2_notebook3_label_encoder_li_medium.pkl
!models/bp4_structuring_smurfing_detection/bp4_notebook3_champion_li_medium.pkl
!models/bp5_correspondent_banking_crossborder_risk/bp5_li_medium_model_v1.pkl
# bp3's champion is a rule JSON, already unaffected by the *.pkl pattern above, listed here only
# for discoverability alongside its siblings:
# models/bp3_network_graph_intelligence/bp3_notebook3_champion_rule_li_medium.json

# Real per-row score baselines (raw per-row model output, same governance as data/raw --
# never committed; one of these was found 167MB, far larger than this platform's other
# baseline files, during the 2026-10-02 hardening pass's GitHub-readiness check)
reports/**/*score_baseline*.json
# Exceptions (2026-10-03): the 4 small (2.2MB each) score-baseline files -- the 167MB
# bp1_score_baseline_li_medium.json stays excluded, far over GitHub's 100MB per-file limit.
!reports/bp4_structuring_smurfing_detection/bp4_score_baseline_hi_small.json
!reports/bp4_structuring_smurfing_detection/bp4_score_baseline_li_medium.json
!reports/bp5_correspondent_banking_crossborder_risk/bp5_score_baseline_hi_small.json
!reports/bp5_correspondent_banking_crossborder_risk/bp5_score_baseline_li_medium.json

# Notebook checkpoints / caches
.ipynb_checkpoints/
**/__pycache__/
*.pyc

# Env / secrets
.env
*.pem
*.key

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
logs/**
!logs/.gitkeep

# Power BI local cache
powerbi/**/*.pbix.bak
_site/
